 110:./User/GaussNewton.c **** {
 111:./User/GaussNewton.c ****     
 112:./User/GaussNewton.c **** 
 113:./User/GaussNewton.c ****     //J_r
 114:./User/GaussNewton.c ****     for(uint8_t i = 0; i < 6; i++)
 115:./User/GaussNewton.c ****     {
 116:./User/GaussNewton.c ****         for(uint8_t j = 0; j < 3; j++)
ARM GAS  /tmp/cc6pnpCj.s 			page 11


 117:./User/GaussNewton.c ****         {
 118:./User/GaussNewton.c ****             //fill the Jacobian matrix with partial derivatives
 119:./User/GaussNewton.c ****             Jr[i][j] = 2*Beta_alpha[j+3]*Beta_alpha[j+3]*diff[i][j];
 120:./User/GaussNewton.c ****             Jr[i][j+3] = -2*Beta_alpha[j+3]*diff[i][j]*diff[i][j];
 121:./User/GaussNewton.c ****         }
 122:./User/GaussNewton.c ****     }
 123:./User/GaussNewton.c **** 
 124:./User/GaussNewton.c ****     //Jr(βα)^T Jr(βα) 6x6 6x6 = 6x6
 125:./User/GaussNewton.c ****     //double Jr_T_Jr[6][6] = {0};
 126:./User/GaussNewton.c ****     //Jr(βα)^T r(βα) 6x6 6x1 = 6x1 r为某特定解下方程的误差
 127:./User/GaussNewton.c ****     //double Jr_T_R[6] = {0};
 128:./User/GaussNewton.c ****     for (uint8_t i = 0; i < 6; i++)
 129:./User/GaussNewton.c ****     {
 130:./User/GaussNewton.c ****         Jr_T_R[i] =0;
 131:./User/GaussNewton.c ****         for(uint8_t j = 0; j < 6; j++)
 132:./User/GaussNewton.c ****         {
 133:./User/GaussNewton.c ****             Jr_T_Jr[i][j] =0;
 134:./User/GaussNewton.c ****             for(uint8_t k = 0; k < 6; k++)
 135:./User/GaussNewton.c ****             {
 136:./User/GaussNewton.c ****                 Jr_T_Jr[i][j] += Jr[k][i] * Jr[k][j];
 137:./User/GaussNewton.c ****             }
 138:./User/GaussNewton.c ****             Jr_T_R[i] += Jr[j][i] * residual[j];
 139:./User/GaussNewton.c ****         }
 140:./User/GaussNewton.c ****     }
 141:./User/GaussNewton.c **** 
