 123:./User/GaussNewton.c ****     {
 124:./User/GaussNewton.c ****         Jr[i][0] = ( 2*diff[i][0] - 2*Beta[0] )*Beta[3]*Beta[3];
 125:./User/GaussNewton.c ****         Jr[i][1] = ( 2*diff[i][1] - 2*Beta[1] )*Beta[4]*Beta[4];
 126:./User/GaussNewton.c ****         Jr[i][2] = ( 2*diff[i][2] - 2*Beta[2] )*Beta[5]*Beta[5];
 127:./User/GaussNewton.c ****         Jr[i][3] = -2*(diff[i][0] - Beta[0] )*(diff[i][0] - Beta[0] )*Beta[3];
 128:./User/GaussNewton.c ****         Jr[i][4] = -2*(diff[i][1] - Beta[1] )*(diff[i][1] - Beta[1] )*Beta[4];
 129:./User/GaussNewton.c ****         Jr[i][5] = -2*(diff[i][2] - Beta[2] )*(diff[i][2] - Beta[2] )*Beta[5];
 130:./User/GaussNewton.c ****     }
 131:./User/GaussNewton.c **** 
