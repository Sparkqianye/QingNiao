 143:./User/GaussNewton.c ****     invert_matrix(Jr_T_Jr,J_invert,6);
 144:./User/GaussNewton.c **** 
 145:./User/GaussNewton.c ****     //delta = [Jr(βα)^T Jr(βα)]^-1  Jr(βα)^T r(βα)
 146:./User/GaussNewton.c ****     //即delta = J_invert Jr_T_R
 147:./User/GaussNewton.c ****     for (uint8_t i = 0; i < 6; i++) {
 148:./User/GaussNewton.c ****         for (uint8_t j = 0; j < 6; j++) {
