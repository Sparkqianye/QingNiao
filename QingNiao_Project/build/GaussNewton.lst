 150:./User/GaussNewton.c ****         }
 151:./User/GaussNewton.c ****     }
 152:./User/GaussNewton.c **** 
 153:./User/GaussNewton.c ****     //β = βα - delta
 154:./User/GaussNewton.c ****     for (uint8_t i = 0; i < 6; i++) 
 155:./User/GaussNewton.c ****     {
 156:./User/GaussNewton.c ****         Beta[i] = Beta_alpha[i] - delta[i];
 157:./User/GaussNewton.c ****         //βα更新 
